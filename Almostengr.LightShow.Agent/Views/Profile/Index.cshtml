@using Almostengr.LightShow.Agent.Services.Profiles
@model List<ProfileResource>

<h1>Profiles</h1>
<div class="mt-3">
    <table class="table table-hover">
        <tr>
            <th>Name</th>
            <th>Modified Date</th>
            <th></th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                    @if (item.IsActive)
                    {
                        <span class="badge text-bg-success ms-2">Active</span>
                    }
                </td>
                <td>@item.ModifiedDate</td>
                <td>
                    <a href="#" data-url="/profile/edit/@item.PublicId" class="modalLink">Edit</a>
                    <a href="#" data-url="/profile/delete/@item.PublicId" class="modalLink">Delete</a>
                </td>
            </tr>
        }
    </table>
</div>