@model ProfileViewModel

<div class="modal-header">
    <h5 class="modal-title">Manage Profile</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <form action="/profile/createedit" method="post">
        <input type="hidden" asp-for="@Model.PublicId" required />
        <div class="mb-3">
            <label for="Value" class="form-label required">Name</label>
            <input type="text" required asp-for="@Model.Name" class="form-input" />
        </div>
        <div class="mb-3">
            <label for="PlayerUrl" class="form-label required">Player Url</label>
            <input type="text" required asp-for="@Model.PlayerUrl" class="form-input" />
        </div>
        <div class="mb-3">
            <label for="WebsiteUrl" class="form-label required">Website Url</label>
            <input type="text" required asp-for="@Model.WebsiteUrl" class="form-input" />
        </div>
        <div class="mb-3">
            <label for="WebsiteApiKey" class="form-label required">Website Api Key</label>
            <input type="text" required asp-for="@Model.WebsiteApiKey" class="form-input" />
        </div>
        <div class="mb-3">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="@Model.IsActive">
                <label class="form-check-label" for="IsActive">
                    Is Active?
                </label>
            </div>
        </div>
        <div class="mb-3">
            <label for="WorkSleepInterval" class="form-label required">Work Sleep Interval</label>
            <input type="number" required asp-for="@Model.WorkSleepInterval" class="form-input" />
        </div>
    </form>
</div>
<partial name="_ModalFooter" />
